App(
    appid="bravia_ui",  # Must be unique
    name="Sony Bravia TV Remote",  # Displayed in menus
    apptype=FlipperAppType.EXTERNAL,
    entry_point="bravia_ui_app",
    stack_size=2 * 1024,
    fap_category="Infrared",
    # Optional values
    # fap_version="0.1",
    fap_icon="bravia_ui.png",  # 10x10 1-bit PNG
    # fap_description="A simple app",
    # fap_author="J. Doe",
    # fap_weburl="https://github.com/user/bravia_ui",
    fap_icon_assets="images",  # Image assets to compile for this application
)
